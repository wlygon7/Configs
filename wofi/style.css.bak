window {
  background: transparent;
}

#outer-box {
  margin: 0;
  padding: 14px;
  background: rgba(20, 20, 30, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 18px;
}

#input {
  margin-bottom: 10px;
  padding: 10px 14px;
  border: none;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.08);
  color: #e6e6f0;
  box-shadow: none;
}

#scroll { margin: 0; }

#entry {
  padding: 8px 10px;
  border-radius: 10px;
}

#entry:selected {
  background: rgba(255, 255, 255, 0.14);
}

#text {
  color: #e6e6f0;
  margin-left: 8px;
}
