# Generated by matugen from ~/.config/matugen/templates/btop.theme. Edit the template, not this file.
# Background is left to the terminal (theme_background = false) so kitty's transparency shows through.

theme[main_bg]="{{colors.surface.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.primary_container.default.hex}}"
theme[selected_fg]="{{colors.on_primary_container.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[meter_bg]="{{colors.surface_container_high.default.hex}}"
theme[proc_misc]="{{colors.primary.default.hex}}"

theme[cpu_box]="{{colors.primary.default.hex}}"
theme[mem_box]="{{colors.tertiary.default.hex}}"
theme[net_box]="{{colors.secondary.default.hex}}"
theme[proc_box]="{{colors.outline.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

theme[temp_start]="{{colors.green.default.hex}}"
theme[temp_mid]="{{colors.yellow.default.hex}}"
theme[temp_end]="{{colors.red.default.hex}}"

theme[cpu_start]="{{colors.primary.default.hex}}"
theme[cpu_mid]="{{colors.tertiary.default.hex}}"
theme[cpu_end]="{{colors.red.default.hex}}"

theme[free_start]="{{colors.green_container.default.hex}}"
theme[free_mid]="{{colors.green.default.hex}}"
theme[free_end]="{{colors.on_green_container.default.hex}}"

theme[cached_start]="{{colors.blue_container.default.hex}}"
theme[cached_mid]="{{colors.blue.default.hex}}"
theme[cached_end]="{{colors.on_blue_container.default.hex}}"

theme[available_start]="{{colors.cyan_container.default.hex}}"
theme[available_mid]="{{colors.cyan.default.hex}}"
theme[available_end]="{{colors.on_cyan_container.default.hex}}"

theme[used_start]="{{colors.yellow.default.hex}}"
theme[used_mid]="{{colors.orange.default.hex}}"
theme[used_end]="{{colors.red.default.hex}}"

theme[download_start]="{{colors.primary_container.default.hex}}"
theme[download_mid]="{{colors.primary.default.hex}}"
theme[download_end]="{{colors.on_primary_container.default.hex}}"

theme[upload_start]="{{colors.tertiary_container.default.hex}}"
theme[upload_mid]="{{colors.tertiary.default.hex}}"
theme[upload_end]="{{colors.on_tertiary_container.default.hex}}"

theme[process_start]="{{colors.primary.default.hex}}"
theme[process_mid]="{{colors.tertiary.default.hex}}"
theme[process_end]="{{colors.red.default.hex}}"
